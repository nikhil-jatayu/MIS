# PostgreSQL connection (SQLAlchemy + psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/MIS
# Optional isolated database used by the backend test suite
TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/MIS_test

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated exact frontend origins
CORS_ORIGINS=http://localhost:3000
COOKIE_NAME=jes_access_token
# Set true when served over HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Optional: set for a shared parent domain, e.g. .jatayues.com
# COOKIE_DOMAIN=

# Login brute-force guard (in-process; use one worker or shared storage when scaling)
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=8

# Local attachment storage
UPLOAD_DIR=var/uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,txt,csv,doc,docx,xls,xlsx,ppt,pptx,zip

SEED_ON_STARTUP=true
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=1440
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_RUN_ON_STARTUP=false

# Password hashing work factor (4 is only for automated tests)
BCRYPT_ROUNDS=12
